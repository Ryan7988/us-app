    "/api/v1/wishes": {
      "get": {
        "tags": [
          "wishes"
        ],
        "summary": "List Wishes",
        "operationId": "list_wishes_api_v1_wishes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "status_filter",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "open",
                "done"
              ],
              "type": "string",
              "default": "all",
              "title": "Status Filter"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
