{
  "name": "us-app-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:api": "cd ../api && uv run python -m app.export_openapi ../web/src/api/openapi.json && cd ../web && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.108.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "idb-keyval": "^6.3.0",
    "leaflet": "~1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "~1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "~0.21.2",
    "vitest": "^3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
