# ===== 複製成 .env：執行 `make init` 會自動產生隨機密鑰 =====
# .env 和 data/ 一樣無法重建：請另存一份到密碼管理器（例如 Bitwarden）

# --- Tailscale ---
# tailnet 上的機器名，決定網址 https://<TS_HOSTNAME>.<tailnet>.ts.net（搬家時必須相同）
TS_HOSTNAME=us-app
# 只在第一次加入 tailnet 時使用；搬家時帶著 data/tailscale 就不需要
TS_AUTHKEY=
# Linux 用 false（核心模式）；Mac / Windows 的 Docker Desktop 若 tailscale 容器起不來，改成 true
TS_USERSPACE=false

# --- 一般 ---
TZ=Asia/Taipei
DATABASE_URL=sqlite:////app/data/db/app.sqlite3

# --- 密鑰（搬家時必須相同）---
# token 簽章；改掉兩人都會被登出
JWT_SECRET=change-me
# 照片簽章 URL
MEDIA_SIGNING_KEY=change-me
# 備份加密密碼；忘記就無法還原！
RESTIC_PASSWORD=change-me

# --- Web Push（P2 啟用；必須相同，否則推播訂閱全部失效）---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI（P3 啟用）---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# --- 備份 ---
# 外接硬碟路徑（依機器修改）；未設定時備份到 ./backups
BACKUP_TARGET=./backups
